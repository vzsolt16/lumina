# Copy this file to .env before running Docker Compose.
JWT_KEY="replace-with-a-strong-random-secret-at-least-32-chars"
ALLOWED_HOSTS="localhost"

# Gemini configuration. The API key is passed only to the backend container.
GEMINI_API_KEY="replace-with-your-gemini-api-key"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com"
GEMINI_DEFAULT_MODEL="gemini-flash"
GEMINI_TIMEOUT_MINUTES="5"
