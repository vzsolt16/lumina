# Copy this file to .env before running Docker Compose.
JWT_KEY="replace-with-a-strong-random-secret-at-least-32-chars"

# Host Ollama mode (default on macOS/Windows Docker Desktop).
OLLAMA_BASE_URL="http://host.docker.internal:11434"
OLLAMA_MODEL="qwen3:4b-instruct"
OLLAMA_TIMEOUT_MINUTES="5"

# For containerized Ollama, run:
# OLLAMA_BASE_URL="http://ollama:11434" docker compose --profile ai up --build
