{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "Lumina",
    "Audience": "LuminaClient",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Gemini": {
    "BaseUrl": "https://generativelanguage.googleapis.com",
    "DefaultModel": "gemini-flash",
    "TimeoutMinutes": 5,
    "Models": {
      "gemini-flash": { "ContextTokens": 1048576 },
      "gemini-3-flash-preview": { "ContextTokens": 1048576 },
      "gemini-flash-lite": { "ContextTokens": 1048576 }
    }
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434/",
    "EmbeddingModel": "embeddinggemma-2:270m",
    "EmbeddingTimeoutSeconds": 120
  },
  "Qdrant": {
    "BaseUrl": "http://localhost:6333/",
    "Collection": "lumina_document_chunks",
    "TimeoutSeconds": 30
  },
  "Rag": {
    "ChunkTokens": 400,
    "OverlapTokens": 60,
    "IndexDebounceMs": 2500,
    "TopK": 5,
    "ContextTokenBudget": 12000,
    "FullDocumentMaxTokens": 2000,
    "RelevanceThreshold": 0.65,
    "Telemetry": {
      "CaptureContent": false
    }
  },
  "Chat": {
    "MaxOutputTokens": 4000,
    "ContextSafetyMarginTokens": 2048
  }
}
